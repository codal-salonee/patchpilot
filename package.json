{
  "name": "@patchpilot/bot",
  "version": "0.1.0",
  "description": "A guarded, CI-driven repair bot for TypeScript repositories",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "patchpilot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test scripts",
    "test": "node --import tsx --test test/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.9.1"
  }
}
